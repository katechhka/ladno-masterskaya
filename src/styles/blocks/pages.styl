.site-main
  min-height 65vh

.breadcrumbs
  padding-top 25px
  &__list
    display flex
    flex-wrap wrap
    gap 8px 12px
    margin 0
    padding 0
    list-style none
    color var(--color-muted)
    font-size 12px
    li:not(:last-child)::after
      content '/'
      margin-left 12px
      color #aaa393
    a:hover
      color var(--color-cobalt)

.page-heading
  padding-block 42px 44px
  &__title
    max-width 1150px
    margin-bottom 24px
    font-family var(--font-display)
    font-size clamp(32px, 4.8vw, 68px)
    line-height 1.2
    font-weight 650
    letter-spacing -.045em
    word-spacing .08em
    text-transform uppercase
  &__intro
    max-width 650px
    margin-bottom 0
    color var(--color-muted)
    font-size 17px
  &--detail
    padding-bottom 35px
    .page-heading__title
      max-width 1050px
      font-size clamp(30px, 4vw, 58px)

.page-section
  padding-block var(--space-section) 0
  &:last-child
    padding-bottom var(--space-section)

.section-note
  max-width 900px
  margin-top 28px
  color var(--color-muted)
  font-size 12px
  line-height 1.6

.loading-state
  padding 30px 0
  color var(--color-muted)
  font-size 14px
  &::before
    display inline-block
    width 12px
    height 12px
    margin-right 12px
    border 2px solid var(--color-line)
    border-top-color var(--color-cobalt)
    border-radius 50%
    content ''
    animation loading-spin 1s linear infinite

@keyframes loading-spin
  to
    transform rotate(360deg)

.empty-state
  display grid
  justify-items start
  gap 17px
  padding 48px 30px
  border 1px solid var(--color-ink)
  background var(--color-white)
  h2, h3
    max-width 700px
    margin 0
    font-family var(--font-display)
    font-size clamp(20px, 2.5vw, 30px)
    font-weight 500
    letter-spacing -.04em
    line-height 1.4
  p
    max-width 600px
    margin 0
    font-size 14px
    color var(--color-muted)
  &__mark
    font-family var(--font-display)
    font-size 45px
    font-weight 650
    color var(--color-cobalt)
  &--compact
    gap 12px
    padding 22px 0
    border 0
    background transparent
    h3
      font-size 19px
  &--error
    border-color var(--color-error)

.icon-button
  display inline-grid
  place-items center
  flex-shrink 0
  min-width 44px
  min-height 44px
  padding 3px 10px
  border 1px solid currentColor
  border-radius 0
  background transparent
  color inherit
  font-size 25px
  line-height 1
  &:hover
    background var(--color-cobalt)
    color var(--color-white)
  &:disabled
    background #e5dfd3
    color #8d887b
    border-color #c6c0b2

.visit-steps
  display grid
  grid-template-columns repeat(4, minmax(0, 1fr))
  gap 26px
  margin 0
  padding 0
  list-style none
  &__item
    border-top 2px solid var(--color-ink)
    padding-top 20px
    h3
      margin-block 20px 12px
      font-family var(--font-display)
      font-size 19px
      font-weight 500
      letter-spacing -.04em
      line-height 1.4
    p
      margin-bottom 0
      font-size 14px
      color var(--color-muted)
  &__number
    font-family var(--font-display)
    font-size 42px
    font-weight 550
    color var(--color-clay)

.teacher-grid
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  border-top 1px solid var(--color-ink)
  border-left 1px solid var(--color-ink)

.teacher-card
  position relative
  padding 30px 32px
  border-right 1px solid var(--color-ink)
  border-bottom 1px solid var(--color-ink)
  &__number
    display block
    margin-bottom 30px
    color var(--color-clay)
    font-size 12px
  &__role
    margin-bottom 9px
    color var(--color-muted)
    font-size 12px
    text-transform uppercase
  &__name
    font-family var(--font-display)
    font-size 24px
    letter-spacing -.04em
    line-height 1.4
    font-weight 500
  p:last-child
    max-width 470px
    margin-bottom 0
    font-size 14px

.faq
  border-top 2px solid var(--color-ink)
  &__item
    border-bottom 1px solid var(--color-ink)
  &__question
    display flex
    align-items center
    justify-content space-between
    gap 24px
    min-height 83px
    padding 20px 0
    font-size 19px
    font-weight 550
    list-style none
    cursor pointer
    &::-webkit-details-marker
      display none
    span
      font-size 28px
      font-weight 400
  &__item[open] &__question span
    transform rotate(45deg)
  &__answer
    max-width 800px
    padding-bottom 22px
    color var(--color-muted)
    font-size 15px
    p
      margin-bottom 0

.location-block
  display grid
  grid-template-columns 1fr 1fr
  align-items center
  gap 50px
  margin-block var(--space-section)
  padding-block 40px
  border-top 2px solid var(--color-ink)
  border-bottom 2px solid var(--color-ink)
  &__city
    color var(--color-clay)
    font-family var(--font-display)
    font-size clamp(65px, 10vw, 144px)
    font-weight 650
    letter-spacing -.065em
    line-height 1
  &__copy
    max-width 510px
    h2
      font-family var(--font-display)
      font-size 25px
      font-weight 500
      line-height 1.4
      letter-spacing -.035em
    p:not(.eyebrow)
      font-size 14px
      color var(--color-muted)

.catalog
  padding-bottom var(--space-section)
  &__result-bar
    display flex
    justify-content space-between
    align-items center
    gap 20px
    padding-block 28px
  &__count
    margin 0
    font-size 14px
    font-weight 600

.catalog-filter
  display grid
  grid-template-columns 1.3fr 1fr .8fr 1fr auto
  align-items end
  gap 16px
  padding-block 28px
  border-top 2px solid var(--color-ink)
  border-bottom 1px solid var(--color-ink)
  .field__input
    font-size 14px
    padding-inline 11px
  &__reset
    box-shadow none
    min-height 54px
    padding-inline 15px

.catalog-grid
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 32px 24px

.catalog-card
  display flex
  flex-direction column
  min-width 0
  border 1px solid var(--color-ink)
  background var(--color-white)
  &__image-link
    display block
    position relative
    overflow hidden
  &__picture
    display block
    aspect-ratio 4 / 3
    img
      width 100%
      height 100%
      object-fit cover
      transition transform .35s
  &__image-link:hover &__picture img
    transform scale(1.035)
  &__age
    position absolute
    top 12px
    right 12px
    padding 5px 9px
    background var(--color-paper)
    border 1px solid var(--color-ink)
    font-size 12px
    font-weight 550
  &__body
    flex 1
    padding 20px 20px 24px
  &__meta
    display flex
    justify-content space-between
    flex-wrap wrap
    gap 7px 12px
    margin-bottom 15px
    font-size 10px
    text-transform uppercase
    color var(--color-muted)
  &__title
    margin-bottom 14px
    font-family var(--font-display)
    font-size clamp(19px, 1.7vw, 25px)
    font-weight 500
    line-height 1.4
    letter-spacing -.035em
    a
      text-decoration none
      &:hover
        color var(--color-clay)
  &__summary
    margin-bottom 0
    font-size 14px
    color var(--color-muted)
  &__footer
    display flex
    align-items center
    justify-content space-between
    gap 14px
    padding 18px 20px
    border-top 1px dashed var(--color-ink)
  &__price
    font-family var(--font-display)
    font-size 20px
    letter-spacing -.03em
    font-weight 500
    white-space nowrap
    small
      display block
      margin-top 5px
      font-family var(--font-body)
      font-size 10px
      font-weight 400
      letter-spacing 0
  &__more
    display flex
    align-items center
    gap 10px
    min-height 44px
    font-size 12px
    font-weight 600
    span
      font-size 25px

.workshop-layout
  display grid
  grid-template-columns minmax(0, 1fr) 350px
  align-items start
  gap clamp(25px, 4vw, 64px)
  &__main
    min-width 0

.gallery
  &__viewport
    position relative
    touch-action pan-y
  &__picture
    display block
    aspect-ratio 4 / 3
    img
      width 100%
      height 100%
      object-fit cover
  &__caption
    margin-top 12px
    font-size 11px
    color var(--color-muted)
  &__controls
    display flex
    gap 14px
    align-items center
    margin-block 16px
  &__counter
    min-width 40px
    text-align center
    font-size 12px
  &__expand
    margin-left auto
    min-height 44px
    border 0
    padding 8px 0
    background transparent
    color var(--color-ink)
    font-size 12px
    font-weight 550
    text-decoration underline
    text-underline-offset 4px
  &__thumbs
    display flex
    gap 10px
  &__thumb
    width 110px
    padding 3px
    border 2px solid transparent
    border-radius 0
    background transparent
    opacity .65
    &--active
      opacity 1
      border-color var(--color-cobalt)
    img
      width 100%
      height 70px
      object-fit cover

.has-dialog
  overflow hidden

.gallery-dialog
  position fixed
  width calc(100% - 36px)
  max-width 1100px
  max-height calc(100dvh - 36px)
  padding 22px
  border 1px solid var(--color-ink)
  background var(--color-paper)
  &::backdrop
    background #181c24db
  &__close
    position absolute
    top 12px
    right 12px
    z-index 2
    background var(--color-paper)
  &__image
    width 100%
    max-height 72dvh
    object-fit contain
  &__caption
    margin-block 18px
    padding-right 30px
    font-size 13px
  &__navigation
    display flex
    justify-content center
    gap 20px

.workshop-facts
  display grid
  grid-template-columns repeat(4, minmax(0, 1fr))
  gap 20px
  margin-block 36px 0
  padding 22px 0
  border-block 1px solid var(--color-ink)
  list-style none
  li
    display grid
    gap 6px
    font-size 13px
    span
      color var(--color-muted)
      font-size 11px
    strong
      font-weight 600

.content-section
  padding-top 48px
  font-size 15px
  h3
    margin-top 25px
    font-size 17px
    font-weight 600
  &__title
    font-family var(--font-display)
    font-size clamp(22px, 2.3vw, 31px)
    font-weight 500
    line-height 1.4
    letter-spacing -.035em

.process-list
  margin 0
  padding 0
  list-style none
  li
    display grid
    grid-template-columns 35px 1fr
    gap 15px
    padding-block 17px
    border-bottom 1px solid var(--color-line)
  p
    margin 0
  &__number
    color var(--color-clay)
    font-size 13px

.result-note
  margin-top 40px
  padding 25px 28px
  border 1px solid var(--color-ink)
  background var(--color-olive)
  color var(--color-white)
  &__title
    margin-top 14px
    margin-bottom 0
    font-size 20px
    font-weight 500
    line-height 1.5

.materials-list
  display grid
  grid-template-columns 1fr 1fr
  gap 13px 25px
  padding-left 20px
  font-size 14px
  li::marker
    color var(--color-clay)

.teacher-feature
  display grid
  grid-template-columns 72px 1fr
  gap 24px
  .content-section__title
    margin-bottom 6px
  &__initials
    display grid
    place-items center
    width 72px
    height 72px
    background var(--color-cobalt)
    color var(--color-white)
    font-family var(--font-display)
    font-size 22px
    font-weight 500
  &__role
    color var(--color-clay)
    font-size 12px
  small
    color var(--color-muted)
    font-size 11px

.booking-panel
  position sticky
  top 24px
  padding 28px
  border 1px solid var(--color-ink)
  background var(--color-white)
  box-shadow 7px 7px 0 var(--color-line)
  &__title
    margin-bottom 24px
    font-family var(--font-display)
    font-size 31px
    font-weight 550
    letter-spacing -.04em
  &__price
    font-family var(--font-display)
    font-size 30px
    letter-spacing -.04em
    font-weight 500
    span
      display block
      margin-top 7px
      font-family var(--font-body)
      font-size 12px
      font-weight 400
      letter-spacing 0
  &__payment
    margin-block 20px 25px
    padding-block 15px
    border-block 1px dashed var(--color-ink)
    font-size 13px
    font-weight 600
    color var(--color-clay)
  &__note
    margin-top 24px
    font-size 11px
    color var(--color-muted)
  .text-link
    font-size 12px

.session-picker
  display grid
  gap 20px
  &__total
    padding-top 2px
    font-size 17px
    font-weight 600
  .field__input
    font-size 13px
    padding-inline 10px
  .button
    width 100%

.mobile-booking-bar
  display none

.schedule
  padding-bottom var(--space-section)
  &__days
    display grid
    grid-template-columns 1.1fr repeat(7, minmax(0, 1fr))
    gap 8px
    margin-block 28px 42px

.schedule-toolbar
  display flex
  align-items end
  gap 24px
  flex-wrap wrap
  padding-block 24px
  border-top 2px solid var(--color-ink)
  border-bottom 1px solid var(--color-ink)
  &__period
    flex 1
    display flex
    align-items center
    gap 18px
  &__title
    margin 0
    font-family var(--font-display)
    font-size 18px
    font-weight 500
    line-height 1.5
    letter-spacing -.035em
    text-align center
  &__filter
    min-width 220px
    .field__input
      font-size 14px

.week-day
  display flex
  align-items center
  flex-direction column
  justify-content center
  gap 7px
  min-height 112px
  padding 12px 5px
  border 1px solid var(--color-ink)
  border-radius 0
  background transparent
  color var(--color-ink)
  font-size 12px
  strong
    font-family var(--font-display)
    font-size 23px
    font-weight 500
  small
    font-size 10px
  &:hover
    background #e3ddcf
  &--all
    font-weight 600
  &--active
    background var(--color-cobalt)
    color var(--color-white)
    &:hover
      background var(--color-cobalt)

.schedule-day
  margin-bottom 34px
  &__heading
    margin-bottom 0
    padding-block 15px
    border-bottom 2px solid var(--color-ink)
    font-size 16px
    font-weight 600
    &::first-letter
      text-transform uppercase
  &__empty
    margin 0
    padding 21px 0
    color var(--color-muted)
    font-size 13px

.session-row
  display grid
  grid-template-columns 85px minmax(0, 1fr) 130px 210px
  align-items center
  gap 25px
  padding-block 25px
  border-bottom 1px solid var(--color-line)
  &__time
    display grid
    gap 5px
    time
      font-family var(--font-display)
      font-size 19px
      font-weight 500
      letter-spacing -.03em
    span
      font-size 11px
      color var(--color-muted)
  &__category
    margin-bottom 6px
    color var(--color-clay)
    font-size 10px
    text-transform uppercase
  &__program h3
    margin-bottom 8px
    font-size 21px
    font-weight 550
    line-height 1.4
    a
      text-decoration none
      &:hover
        text-decoration underline
  &__details
    margin 0
    color var(--color-muted)
    font-size 12px
  &__price
    display grid
    gap 5px
    strong
      font-size 18px
      font-weight 600
      white-space nowrap
    small
      color var(--color-muted)
      font-size 11px
  &__booking
    display grid
    gap 14px
    justify-items stretch
    .availability
      justify-self start
      font-size 11px
  &__action
    padding 11px 15px
    min-height 48px
    font-size 12px
    box-shadow none
  &--unavailable
    .session-row__program
      color var(--color-muted)

.upcoming-session
  &__date
    margin-bottom 0
    padding-block 15px
    border-bottom 2px solid var(--color-ink)
    color var(--color-cobalt)
    font-size 16px
    font-weight 600
    &::first-letter
      text-transform uppercase

.info-layout
  display grid
  grid-template-columns 280px minmax(0, 1fr)
  align-items start
  gap clamp(35px, 6vw, 96px)
  padding-bottom var(--space-section)

.info-nav
  position sticky
  top 24px
  display grid
  border-top 2px solid var(--color-ink)
  a
    padding-block 16px
    border-bottom 1px solid var(--color-line)
    color var(--color-muted)
    font-size 12px
    text-decoration none
    &:hover
      color var(--color-cobalt)

.info-document
  min-width 0
  max-width 800px
  h2
    font-family var(--font-display)
    font-size clamp(22px, 2.4vw, 32px)
    font-weight 500
    line-height 1.4
    letter-spacing -.035em
  p
    font-size 16px
    line-height 1.8
  &__section
    padding-block 28px
    border-top 1px solid var(--color-line)
    &:first-child
      padding-top 0
      border-top 0

.booking-preview
  display grid
  grid-template-columns 1fr .8fr
  gap 70px
  padding-bottom var(--space-section)
  &__summary
    display grid
    align-content start
    gap 22px
    min-width 0
    .button
      justify-self start
    .notice
      margin 0
  &__notice
    border 1px solid var(--color-ink)
    padding 28px
    background #e4e7db
    h2
      font-family var(--font-display)
      font-size 25px
      font-weight 500
      line-height 1.4
      letter-spacing -.035em
    p
      font-size 14px

.booking-summary
  margin 0
  border-top 2px solid var(--color-ink)
  > div
    display grid
    grid-template-columns 130px 1fr
    gap 25px
    padding-block 20px
    border-bottom 1px solid var(--color-line)
  dt
    color var(--color-muted)
    font-size 13px
  dd
    margin 0
    font-size 16px
    font-weight 550
  > div:last-child dd
    color var(--color-clay)
    font-family var(--font-display)
    font-size 26px
    font-weight 550

.not-found
  padding-block 65px var(--space-section)
  &__number
    margin-block 35px
    font-family var(--font-display)
    font-size clamp(90px, 19vw, 260px)
    font-weight 750
    line-height 1
    letter-spacing -.07em
    color var(--color-cobalt)
    span
      color var(--color-clay)
      display inline-block
      transform rotate(-10deg)
  &__title
    font-family var(--font-display)
    font-size clamp(30px, 4vw, 55px)
    font-weight 600
    line-height 1.3
    letter-spacing -.04em
    text-transform uppercase
  p:not(.eyebrow)
    max-width 570px
    margin-block 25px
    color var(--color-muted)
  &__actions
    display flex
    flex-wrap wrap
    align-items center
    gap 25px

.site-header__link[aria-current='page']
  text-decoration underline
  text-underline-offset 6px

@media (max-width: 1150px)
  .catalog-filter
    grid-template-columns 1.2fr 1fr 1fr
    &__search
      grid-column span 2
  .catalog-grid
    grid-template-columns repeat(2, minmax(0, 1fr))
  .workshop-layout
    grid-template-columns minmax(0, 1fr) 315px
    gap 28px
  .booking-panel
    padding 23px
  .session-row
    grid-template-columns 75px minmax(0, 1fr) 110px 180px
    gap 20px
  .visit-steps
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap 35px 28px

@media (max-width: 900px)
  body[data-page='workshop']
    padding-bottom 82px
  .workshop-layout
    grid-template-columns 1fr
    &__main
      display contents
    .gallery
      grid-row 1
    .workshop-facts
      grid-row 2
  .booking-panel
    position static
    max-width 580px
    width 100%
    grid-row 3
    margin-bottom 15px
  .mobile-booking-bar
    position fixed
    z-index 8
    bottom 0
    left 0
    width 100%
    display flex
    align-items center
    justify-content space-between
    gap 20px
    padding 15px 22px calc(15px + env(safe-area-inset-bottom))
    border-top 2px solid var(--color-ink)
    background var(--color-cobalt)
    color var(--color-white)
    text-decoration none
    span
      font-size 18px
      font-weight 650
    small
      display block
      margin-top 3px
      font-size 10px
      font-weight 400
    strong
      font-size 14px
      font-weight 600
  .has-dialog .mobile-booking-bar
    display none
  .schedule-toolbar__period
    flex-basis 100%
    justify-content space-between
  .schedule__days
    grid-template-columns repeat(7, minmax(0, 1fr))
    gap 7px
  .week-day--all
    grid-column 1 / -1
    min-height 44px
    padding-block 8px
  .session-row
    grid-template-columns 70px minmax(0, 1fr) 155px
    gap 15px
    &__price
      grid-column 2
      grid-row 2
    &__booking
      grid-column 3
      grid-row span 2
  .info-layout
    grid-template-columns 210px minmax(0, 1fr)
    gap 32px
  .booking-preview
    grid-template-columns 1fr
    gap 30px
  .location-block
    grid-template-columns 1fr
    gap 35px
    &__city
      font-size 100px

@media (max-width: 650px)
  .page-heading
    padding-block 32px
    &__title
      font-size clamp(27px, 7.5vw, 43px)
      line-height 1.3
      letter-spacing -.04em
    &__intro
      font-size 15px
    &--detail .page-heading__title
      font-size clamp(28px, 7.8vw, 43px)
  .breadcrumbs
    padding-top 20px
    &__list
      font-size 10px
      gap 7px
  .catalog-filter
    grid-template-columns 1fr
    gap 16px
    &__search
      grid-column 1 / -1
    &__category, &__sort
      grid-column 1 / -1
    &__age
      grid-row auto
    .field__label
      font-size 11px
    .field__input
      font-size 16px
    &__reset
      grid-column 1
      grid-row auto
      justify-self start
      min-height 54px
  .catalog__result-bar
    align-items flex-start
    flex-direction column
    gap 10px
    padding-block 22px
  .catalog-grid
    grid-template-columns 1fr
    gap 26px
  .catalog-card__title
    font-size 23px
  .teacher-grid
    grid-template-columns 1fr
  .teacher-card
    padding 26px
    &__name
      font-size 23px
  .visit-steps
    grid-template-columns 1fr 1fr
    gap 30px 20px
    &__number
      font-size 33px
    &__item
      h3
        font-size 16px
