.cookie-notice
  position fixed
  right 24px
  bottom 24px
  z-index 30
  width calc(100% - 48px)
  max-width 480px
  max-height calc(100dvh - 48px)
  overflow auto
  padding 24px
  border 2px solid var(--color-ink)
  background var(--color-white)
  box-shadow 6px 6px 0 var(--color-ink)
  &__title
    margin-bottom 12px
    font-family var(--font-display)
    font-size 24px
    line-height 1.3
  &__text
    font-size 14px
    line-height 1.6
  &__actions
    display flex
    gap 20px
    align-items center
    flex-wrap wrap
  &__status
    margin 0

html
  scroll-padding-bottom var(--cookie-height, 24px)

.legal-actions
  display flex
  flex-wrap wrap
  gap 24px
  align-items center

@media (max-width: 600px)
  .cookie-notice
    right 16px
    bottom 16px
    width calc(100% - 32px)
    padding 18px
    &__actions
      gap 12px
    &__title
      font-size 21px

@media print
  .site-header, .site-footer, .info-nav, .cookie-notice, .legal-actions, [data-print-document]
    display none !important
  .info-layout
    display block
  .info-document
    max-width none
    color #000
  body
    background #fff
