.admin
  padding-block 44px 90px
  min-height 70vh
  &__heading, &__toolbar
    display flex
    align-items center
    justify-content space-between
    gap 24px
    margin-bottom 32px
  &__title
    font-family var(--font-display)
    font-size clamp(25px, 4vw, 48px)
    line-height 1.3
    letter-spacing -.04em
    margin-bottom 0
  &__login
    display grid
    gap 22px
    max-width 480px
    padding-block 24px
    h2, p
      margin-bottom 0
  &__nav
    display flex
    flex-wrap wrap
    gap 14px
    border-block 1px solid var(--color-ink)
    padding-block 20px
    margin-block 30px
    [aria-current='page']
      background var(--color-cobalt)
      color var(--color-white)
  &__list
    margin-top 24px
  &__row
    display flex
    align-items center
    gap 20px
    padding-block 24px
    border-top 1px solid var(--color-line)
    h3, p
      margin-block 5px
  &__row-copy
    flex 1
    min-width 0
    overflow-wrap anywhere
  &__thumb
    width 100px
    height 76px
    object-fit cover
    border 1px solid var(--color-ink)
  &__tag
    color var(--color-cobalt)
    font-size 13px
    font-weight 650
  &__muted
    color var(--color-muted)
    font-size 14px
  &__form
    display grid
    gap 26px
    margin-top 24px
    max-width 1000px
  &__fields, &__filters
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap 24px
  &__filters
    align-items end
  &__wide
    grid-column 1 / -1
  &__check
    display flex
    align-items center
    gap 12px
    padding-block 14px
    input
      width 20px
      height 20px
      flex-shrink 0
      accent-color var(--color-cobalt)
  &__media
    min-width 0
    display grid
    grid-template-columns repeat(4, minmax(0, 1fr))
    gap 14px
    margin 0
    padding 20px
    border 1px solid var(--color-ink)
  &__media-item
    display flex
    flex-direction column
    gap 8px
    min-width 0
    font-size 12px
    padding 10px
    border 1px solid var(--color-line)
    img
      width 100%
      height 100px
      object-fit cover
    input
      width 22px
      height 22px
      accent-color var(--color-cobalt)
    &:has(input:checked)
      outline 2px solid var(--color-cobalt)
      background #e9edf2
  &__repeat
    border-block 1px solid var(--color-line)
    padding-block 20px
    summary
      cursor pointer
      font-weight 600
      padding-bottom 14px
  &__weekdays, &__actions
    display flex
    flex-wrap wrap
    gap 18px
  &__booking
    padding-block 26px
    border-top 1px solid var(--color-ink)
    overflow-wrap anywhere
    h3
      margin-block 12px
  &__contacts
    display flex
    flex-wrap wrap
    gap 10px
  .notice
    overflow-wrap anywhere

.admin-upload
  padding 24px
  border 1px solid var(--color-ink)
  background #e8ebdf
  &__previews
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap 20px
    margin-block 20px
  &__preview
    min-width 0
    overflow-wrap anywhere
    img
      width 100%
      height 160px
      object-fit cover
    p
      font-size 13px

@media (max-width: 900px)
  .admin
    &__media
      grid-template-columns repeat(3, minmax(0, 1fr))
    &__row
      flex-wrap wrap

@media (max-width: 600px)
  .admin-upload
    padding 16px
    &__previews
      grid-template-columns 1fr
  .admin
    &__heading, &__toolbar
      align-items flex-start
      flex-direction column
    &__fields, &__filters
      grid-template-columns 1fr
    &__media
      padding 12px
      grid-template-columns repeat(2, minmax(0, 1fr))
    &__row-copy
      flex-basis calc(100% - 120px)
    &__nav .button
      flex 1 1 40%
      padding-inline 10px
