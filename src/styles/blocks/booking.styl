.booking-form
  display grid
  gap 18px
  margin-block 30px
  padding-top 26px
  border-top 1px solid var(--color-ink)
  h2, h3, p
    margin 0
  &__grid
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap 20px
  .field
    align-content start
  &__consent
    display flex
    align-items flex-start
    gap 12px
    font-size 14px
    line-height 1.6
    input
      flex-shrink 0
      width 20px
      height 20px
      margin-top 2px
      accent-color var(--color-cobalt)
  &__payment
    padding-block 16px
    border-block 1px solid var(--color-ink)
    color var(--color-clay)
    font-weight 650
  &__actions
    display flex
    flex-wrap wrap
    align-items center
    gap 22px

.booking-preview__summary
  min-width 0
  overflow-wrap anywhere
  > .text-link
    margin-top 20px

.booking-preview__notice
  align-self start

@media (max-width: 600px)
  .booking-form__grid
    grid-template-columns 1fr
