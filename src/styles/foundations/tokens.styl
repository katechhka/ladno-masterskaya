:root
  --color-paper #f6f1e7
  --color-white #fffcf6
  --color-ink #292b25
  --color-muted #6e6b60
  --color-clay #aa432f
  --color-clay-hover #8b3525
  --color-cobalt #304f96
  --color-olive #5a654b
  --color-line #d9d2c4
  --color-error #a32c25
  --font-body 'Onest Variable', Arial, sans-serif
  --font-display 'Unbounded Variable', Arial, sans-serif
  --page-gutter clamp(20px, 4.1vw, 64px)
  --page-width 1440px
  --space-section clamp(64px, 7.2vw, 112px)
  --ease-out cubic-bezier(.22, .61, .36, 1)
