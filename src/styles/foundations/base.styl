*, *::before, *::after
  box-sizing border-box

html
  scroll-behavior smooth
  scroll-padding-top 24px

body
  margin 0
  background var(--color-paper)
  color var(--color-ink)
  font-family var(--font-body)
  font-size 16px
  line-height 1.6
  -webkit-font-smoothing antialiased

::selection
  background #d9ddc7
  color var(--color-ink)

a
  color inherit
  text-underline-offset 5px
  text-decoration-thickness 1px

button, input, select, textarea
  font inherit

button, a, input, select, textarea, summary
  -webkit-tap-highlight-color transparent

button
  cursor pointer

button:disabled
  cursor not-allowed

img, svg
  max-width 100%

img
  display block
  height auto

figure
  margin 0

h1, h2, h3, p
  margin-top 0

:focus-visible
  outline 3px solid var(--color-cobalt)
  outline-offset 5px

[hidden]
  display none !important

.container
  width 100%
  max-width var(--page-width)
  margin-inline auto
  padding-inline var(--page-gutter)

.skip-link
  position absolute
  z-index 100
  top -100px
  left 12px
  padding 12px 20px
  background var(--color-white)
  &:focus
    top 12px

.eyebrow
  font-size 12px
  font-weight 600
  letter-spacing .04em
  line-height 1.5
  text-transform uppercase

.section-title
  max-width 850px
  margin-bottom 24px
  font-family var(--font-display)
  font-size clamp(26px, 3.5vw, 50px)
  font-weight 650
  letter-spacing -.04em
  word-spacing .12em
  line-height 1.25
  text-transform uppercase

.foundation
  max-width 940px
  margin-inline auto
  padding 56px var(--page-gutter) 100px
  min-height 65vh
  overflow-wrap anywhere
  &__stage
    padding-bottom 20px
    color var(--color-muted)
    font-size 12px
    border-bottom 1px solid var(--color-line)
  h1
    font-family var(--font-display)
    font-size clamp(28px, 4vw, 52px)
    line-height 1.3
    font-weight 650
    letter-spacing -.045em
  h2
    margin-top 32px
    font-size 23px
    line-height 1.3
  li
    margin-bottom 12px

@media (prefers-reduced-motion: reduce)
  html
    scroll-behavior auto
  *, *::before, *::after
    animation-duration .01ms !important
    transition-duration .01ms !important
    animation-iteration-count 1 !important
