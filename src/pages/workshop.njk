{% extends "pages/layout.njk" %}
{% from "partials/picture.njk" import picture %}
{% from "partials/workshop-card.njk" import workshopCard %}
{% block content %}
{% set workshop = page.workshop %}
<div class="container">{% include "partials/breadcrumbs.njk" %}<header class="page-heading page-heading--detail"><p class="eyebrow">{{ page.category.name }} / {{ workshop.level }}</p><h1 class="page-heading__title">{{ workshop.title }}</h1><p class="page-heading__intro">{{ workshop.summary }}</p></header></div>
<div class="workshop-layout container">
  <div class="workshop-layout__main">
    <section class="gallery" data-gallery aria-label="Фотографии занятия {{ workshop.title }}" aria-roledescription="карусель">
      <div class="gallery__viewport" data-gallery-viewport tabindex="0" aria-label="Галерея. Листайте стрелками влево и вправо">{% for imageId in page.gallery %}<figure class="gallery__slide" data-gallery-slide{% if not loop.first %} hidden{% endif %} aria-label="{{ loop.index }} из {{ page.gallery | length }}">{{ picture(images[imageId], 'gallery__picture', '(max-width: 900px) 100vw, 62vw', loop.first) }}<figcaption class="gallery__caption">{{ images[imageId].alt }}</figcaption></figure>{% endfor %}</div>
      <div class="gallery__controls"><button class="icon-button" type="button" data-gallery-prev aria-label="Предыдущее фото">←</button><span class="gallery__counter" data-gallery-counter aria-live="polite">1 / {{ page.gallery | length }}</span><button class="icon-button" type="button" data-gallery-next aria-label="Следующее фото">→</button><button class="gallery__expand" type="button" data-gallery-open>Рассмотреть крупнее ↗</button></div>
      <div class="gallery__thumbs" role="group" aria-label="Выбор фотографии">{% for imageId in page.gallery %}<button class="gallery__thumb{% if loop.first %} gallery__thumb--active{% endif %}" type="button" data-gallery-index="{{ loop.index0 }}" aria-pressed="{% if loop.first %}true{% else %}false{% endif %}" aria-label="Фото {{ loop.index }}: {{ images[imageId].alt }}">{{ picture(images[imageId], '', '140px') }}</button>{% endfor %}</div>
      <dialog class="gallery-dialog" data-gallery-dialog aria-label="Увеличенная фотография"><button class="gallery-dialog__close icon-button" type="button" data-gallery-close aria-label="Закрыть фотографию">×</button><img class="gallery-dialog__image" data-gallery-dialog-image alt=""><p class="gallery-dialog__caption" data-gallery-dialog-caption></p><div class="gallery-dialog__navigation"><button class="icon-button" type="button" data-gallery-prev aria-label="Предыдущее фото">←</button><button class="icon-button" type="button" data-gallery-next aria-label="Следующее фото">→</button></div></dialog>
      <noscript><p class="section-note">Для просмотра остальных фотографий и увеличения включите JavaScript.</p></noscript>
    </section>
    <ul class="workshop-facts"><li><span>Длительность</span><strong>{{ workshop.durationMinutes | duration }}</strong></li><li><span>Возраст</span><strong>{{ workshop.minAge }}+</strong></li><li><span>Опыт</span><strong>{{ workshop.level }}</strong></li><li><span>Группа</span><strong>до {{ workshop.capacity }} человек</strong></li></ul>
    <section class="content-section"><p class="eyebrow">01 / Что будем делать</p><h2 class="content-section__title">Пробуем шаг за шагом.</h2><ol class="process-list">{% for step in workshop.process %}<li><span class="process-list__number">0{{ loop.index }}</span><p>{{ step }}</p></li>{% endfor %}</ol></section>
    <section class="result-note"><span class="eyebrow">Ваша работа</span><h2 class="result-note__title">{{ workshop.result }}</h2></section>
    <section class="content-section"><p class="eyebrow">02 / Всё подготовлено</p><h2 class="content-section__title">Входит в стоимость.</h2><ul class="materials-list">{% for material in workshop.materials %}<li>{{ material }}</li>{% endfor %}</ul></section>
    <section class="content-section"><p class="eyebrow">03 / Будет рядом</p><div class="teacher-feature"><span class="teacher-feature__initials" aria-hidden="true">{{ page.teacher.initials }}</span><div><h2 class="content-section__title">{{ page.teacher.name }}</h2><p class="teacher-feature__role">{{ page.teacher.role }}</p><p>{{ page.teacher.bio }}</p><small>Вымышленный преподаватель портфолио-проекта.</small></div></div></section>
    <section class="content-section"><p class="eyebrow">04 / Важные детали</p><h2 class="content-section__title">Перед встречей.</h2><h3>Одежда и подготовка</h3><p>{{ workshop.preparation }}</p><h3>Получение работы</h3><p>{{ workshop.pickup }}</p><h3>Если планы поменяются</h3><p>Отменить всю запись можно по персональной ссылке до начала занятия. По возможности предупредите за 24 часа. Для смены даты отмените запись и оформите новую. <a href="/rules/">Все правила посещения</a>.</p></section>
  </div>
  <aside class="booking-panel" id="choose-session" aria-labelledby="booking-title"><p class="eyebrow">Найдите время для себя</p><h2 class="booking-panel__title" id="booking-title">Сделаем?</h2><p class="booking-panel__price">{{ workshop.priceRub | money }}<span>за одного участника</span></p><p class="booking-panel__payment">{{ site.paymentNotice }}</p><div data-session-picker data-workshop="{{ workshop.id }}"><p class="loading-state" role="status">Смотрим ближайшие даты…</p></div><noscript><p>Для выбора даты включите JavaScript.</p></noscript><p class="booking-panel__note">Бронь сохраняется после подтверждения. Для просмотра и отмены сохраните персональную ссылку.</p><a class="text-link" href="/schedule/">Посмотреть всё расписание ↗</a></aside>
</div>
<section class="page-section container" aria-labelledby="related-title"><div class="section-heading"><p class="eyebrow">Ещё один повод попробовать</p><h2 class="section-title" id="related-title">А может, вот это?</h2></div><div class="catalog-grid">{% for related in page.related %}{{ workshopCard(related, images, site.categories) }}{% endfor %}</div></section>
<a class="mobile-booking-bar" href="#choose-session"><span>{{ workshop.priceRub | money }}<small>за участника</small></span><strong>Выбрать дату ↗</strong></a>
{% endblock %}
