{% extends "pages/layout.njk" %}
{% block content %}
<div class="container">{% include "partials/breadcrumbs.njk" %}<header class="page-heading"><p class="eyebrow">Понятные условия</p><h1 class="page-heading__title">{% if page.kind == 'rules' %}Договоримся<br>на берегу.{% else %}Ваши данные.<br>Честно и понятно.{% endif %}</h1><p class="page-heading__intro">{% if page.kind == 'rules' %}Что приготовить к встрече, когда забирать работу и как поступить, если планы изменились.{% else %}«Ладно» — вымышленная мастерская для портфолио. Используйте только тестовые контакты.{% endif %}</p></header></div>
<div class="info-layout container"><nav class="info-nav" aria-label="Разделы документа">{% if page.kind == 'rules' %}{% for rule in site.rules %}<a href="#rule-{{ loop.index }}">0{{ loop.index }} / {{ rule.title }}</a>{% endfor %}{% else %}<a href="#data-info">О демонстрационных данных</a><a href="/rules/">Правила посещения ↗</a>{% endif %}</nav><article class="info-document">{% if page.kind == 'rules' %}{% for rule in site.rules %}<section class="info-document__section" id="rule-{{ loop.index }}"><p class="eyebrow">0{{ loop.index }}</p><h2>{{ rule.title }}</h2><p>{{ rule.text }}</p></section>{% endfor %}{% else %}<section id="data-info"><h2>{{ site.privacy.title }}</h2><p class="notice">Форма записи работает с демонстрационной базой. Используйте вымышленные контакты. Письма и SMS не отправляются.</p>{% for paragraph in site.privacy.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}</section>{% endif %}<a class="button button--secondary" href="/master-classes/">К мастер-классам ↗</a></article></div>
{% endblock %}
