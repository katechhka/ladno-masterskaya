{
  "name": "ladno-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "telegram:bot": "node --env-file-if-exists=.env server/telegram-bot.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "cloud:setup": "node --env-file=.env.vercel scripts/cloud-setup.mjs",
    "cloud:backup": "node --env-file-if-exists=.env --env-file=.env.cloud-secrets scripts/backup-cloud.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "content:check": "node scripts/check-content.mjs",
    "schedule:export": "node --env-file-if-exists=.env scripts/export-schedule.mjs",
    "assets:fonts": "node scripts/prepare-fonts.mjs",
    "assets:images": "node scripts/prepare-images.mjs",
    "assets:check": "node scripts/check-images.mjs",
    "design:check": "node scripts/check-design.mjs",
    "pages:check": "node scripts/check-pages.mjs",
    "booking:check": "node scripts/check-booking.mjs",
    "functional:check": "node scripts/check-functional.mjs",
    "notifications:check": "node scripts/check-phone-telegram.mjs",
    "visual:check": "node scripts/check-visual.mjs",
    "production:check": "node scripts/check-production.mjs",
    "acceptance:check": "node scripts/check-acceptance.mjs",
    "admin:setup": "node --env-file-if-exists=.env scripts/setup-admin.mjs",
    "admin:check": "node scripts/check-admin.mjs",
    "privacy:check": "node scripts/check-privacy-media.mjs",
    "legal:pdf": "node scripts/export-legal.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "backup:create": "node --env-file-if-exists=.env scripts/backup.mjs",
    "backup:restore": "node --env-file-if-exists=.env scripts/restore.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:process": "node --test tests/process-bookings.test.mjs",
    "test:backup": "node --test tests/backups.test.mjs",
    "test:async": "node --test tests/async-storage.test.mjs",
    "cloud:check": "node --env-file-if-exists=.env scripts/check-cloud.mjs",
    "test:all": "node scripts/check-all.mjs"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.8.2",
    "better-sqlite3": "^12.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jquery": "3.7.1",
    "nunjucks": "^3.2.4",
    "sharp": "^0.34.5",
    "undici": "^7.30.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "stylus": "^0.64.0",
    "vite": "^7.0.0"
  }
}
