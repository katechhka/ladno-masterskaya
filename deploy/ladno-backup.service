[Unit]
Description=Ladno SQLite and photos backup

[Service]
Type=oneshot
User=ladno
Group=ladno
WorkingDirectory=/srv/ladno/app
EnvironmentFile=/etc/ladno.env
ExecStart=/usr/bin/node scripts/backup.mjs
UMask=0077
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ladno
