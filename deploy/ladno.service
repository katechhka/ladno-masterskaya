[Unit]
Description=Ladno workshop website
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=ladno
Group=ladno
WorkingDirectory=/srv/ladno/app
EnvironmentFile=/etc/ladno.env
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ladno

[Install]
WantedBy=multi-user.target
