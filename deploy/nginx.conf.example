# Замените workshop.example своим доменом и укажите действующий сертификат.
# Пример для ОДНОГО прокси перед Node.js, без CDN.
server {
    listen 80;
    server_name workshop.example;
    return 308 https://workshop.example$request_uri;
}

server {
    listen 443 ssl;
    server_name workshop.example;
    ssl_certificate /etc/letsencrypt/live/workshop.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/workshop.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 11m;

    # Не записывать пути и параметры персональных действий в access log.
    access_log off;
    # Подробные upstream-ошибки могут содержать URL; отдельный защищённый журнал.
    error_log /var/log/nginx/ladno-error.log crit;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
