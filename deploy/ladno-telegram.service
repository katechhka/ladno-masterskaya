[Unit]
Description=Ladno Telegram confirmation worker
After=network-online.target ladno.service
Wants=network-online.target

[Service]
Type=exec
User=ladno
Group=ladno
WorkingDirectory=/srv/ladno/app
EnvironmentFile=/etc/ladno.env
ExecStart=/usr/bin/node server/telegram-bot.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ladno

[Install]
WantedBy=multi-user.target
