# Рабочая база находится вне dist. Не включайте её в публичные файлы.
DATABASE_PATH=storage/ladno.sqlite
# Постоянный каталог пользовательских фотографий, вне dist.
UPLOADS_DIR=storage/uploads
# Закрытый каталог копий базы и загруженных фотографий.
BACKUP_DIR=storage/backups
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
NODE_ENV=development
TRUST_PROXY=0
# Создайте бота через @BotFather; секреты не должны иметь префикс VITE_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# HTTP(S)-прокси, только если прямой доступ к Telegram недоступен.
TELEGRAM_PROXY_URL=
# Для Vercel: значения выдаются подключёнными хранилищами, не заполняйте VITE_*.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
# Отдельные длинные случайные секреты облачного варианта.
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
# Только для первого создания облачного владельца: scrypt-хеш, не пароль.
ADMIN_INITIAL_HASH=
